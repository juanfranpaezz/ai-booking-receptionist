# Copy to .env and fill in your own key. NEVER commit the real .env.
# The app reads ANTHROPIC_API_KEY from the environment by name — it is never
# hardcoded anywhere in the source.
#
# Get a key at https://console.anthropic.com/ . It looks like sk-ant-...
# (placeholder only below — do NOT paste a real key into this example file).
ANTHROPIC_API_KEY=

# Optional: override the model used in interactive mode (default claude-sonnet-4-6).
# BOOKING_RECEPTIONIST_MODEL=claude-sonnet-4-6
